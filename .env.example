# ---- Arius environment ----
# Copy to .env and adjust.

# Transactional DB (YugabyteDB, PostgreSQL wire protocol, note port 5433)
YB_URL=postgresql+psycopg://yugabyte:yugabyte@localhost:5433/arius

# Time-series DB (Tiger Data / TimescaleDB image, host port 5434 —
# 5432 is usually taken by a local PostgreSQL install)
TD_URL=postgresql+psycopg://arius:arius@localhost:5434/arius

# auto   = try Yugabyte, fall back to SQLite if unreachable (dev)
# yugabyte = require Yugabyte
# sqlite = force local SQLite file
DB_MODE=auto
SQLITE_PATH=arius_dev.db

# Gemini (Phase 5). Leave empty until you have a key.
GEMINI_API_KEY=

# Frontend dev origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
